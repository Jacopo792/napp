# Local one-time operations only. Never add these values to the frontend or GitHub Pages build.
SUPABASE_SERVICE_ROLE_KEY=
MASTER_SEED=

# Existing Supabase Auth accounts. The legacy passphrases are needed only once
# to rewrap an archive created before the single-step email/password login.
USER_ONE_EMAIL=
USER_ONE_PASSWORD=
USER_ONE_PASSPHRASE=
USER_TWO_EMAIL=
USER_TWO_PASSWORD=
USER_TWO_PASSPHRASE=

# Optional. `pnpm add:member` connects this account to the archive by writing its
# public.archive_members row; `--user-id=<uuid>` works instead when the password
# is not available locally.
NEW_MEMBER_EMAIL=
NEW_MEMBER_PASSWORD=

# Optional. `pnpm verify:supabase` checks a third member when these are set, and
# confirms an authenticated account with no membership is still refused.
USER_THREE_EMAIL=
USER_THREE_PASSWORD=
USER_OUTSIDER_EMAIL=
USER_OUTSIDER_PASSWORD=
