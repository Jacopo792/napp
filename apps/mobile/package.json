{
  "name": "@notes-app/mobile",
  "version": "0.9.46",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "scripts": {
    "editor": "vite build --config editor/vite.config.ts",
    "start": "pnpm editor && expo start --dev-client",
    "preview": "NAPP_PREVIEW=1 pnpm editor && NAPP_PREVIEW=1 expo start --dev-client --clear",
    "ios": "pnpm editor && expo run:ios",
    "android": "pnpm editor && expo run:android",
    "build:android": "node scripts/build-android.cjs",
    "build:android:store": "node scripts/build-android.cjs --store"
  },
  "dependencies": {
    "@expo/ui": "~58.0.0",
    "@notes-app/core": "workspace:*",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-glass-effect": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-teleport": "1.2.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-preset-expo": "~58.0.16",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "description": "Notes — a shared archive for two",
  "author": "Jacopo792"
}
