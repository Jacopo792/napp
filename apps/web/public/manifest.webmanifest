{
  "name": "Napp",
  "short_name": "Napp",
  "start_url": "./notes",
  "scope": "./",
  "display": "standalone",
  "background_color": "#131313",
  "theme_color": "#131313",
  "icons": [
    {
      "src": "napp-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "napp-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
