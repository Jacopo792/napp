{
  "name": "notes-app",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @notes-app/web dev",
    "dev:desktop": "pnpm --filter @notes-app/desktop dev",
    "build": "pnpm --filter @notes-app/web build",
    "build:desktop": "pnpm --filter @notes-app/desktop build",
    "build:desktop:mac": "pnpm --filter @notes-app/desktop build:mac",
    "build:desktop:win": "pnpm --filter @notes-app/desktop build:win",
    "release:desktop:mac": "pnpm --filter @notes-app/desktop release:mac",
    "release:desktop:win": "pnpm --filter @notes-app/desktop release:win",
    "preview:dist": "pnpm --filter @notes-app/web preview:dist",
    "preview:ui": "vite dev --config vite.preview.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop && tsc --noEmit -p packages/collab-server && tsc --noEmit",
    "test": "node --experimental-strip-types --test \"packages/core/src/**/*.test.ts\"",
    "test:server": "pnpm --filter @notes-app/collab-server test",
    "format": "prettier --write '**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml,html}'",
    "format:check": "prettier --check '**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml,html}'",
    "provision:supabase": "node --experimental-strip-types scripts/migrate-to-supabase.mjs --provision-only",
    "migrate:supabase": "node --experimental-strip-types scripts/migrate-to-supabase.mjs",
    "migrate:account-only": "node --experimental-strip-types scripts/migrate-to-account-only.mjs",
    "add:member": "node --experimental-strip-types scripts/add-archive-member.mjs",
    "verify:supabase": "node --experimental-strip-types scripts/verify-supabase.mjs",
    "verify:supabase:local": "node --experimental-strip-types scripts/verify-supabase-local.mjs",
    "healthcheck": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && VITE_BASE_PATH=/note-sharing-app/ pnpm build && git diff --check",
    "healthcheck:full": "pnpm healthcheck && REQUIRE_INTEGRATION=1 REDIS_URL=redis://127.0.0.1:6380 pnpm test:server && pnpm verify:supabase:local"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@notes-app/core": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.2",
    "yjs": "13.6.32"
  },
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=11"
  }
}
