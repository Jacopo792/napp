{
  "name": "notes-app",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview:dist": "vite preview",
    "preview:ui": "vite dev --config vite.preview.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/features/editor/lib/*.test.ts",
    "test:server": "pnpm --filter @notes-app/collab-server test",
    "format": "prettier --write '**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml,html}'",
    "format:check": "prettier --check '**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml,html}'",
    "provision:supabase": "node --experimental-strip-types scripts/migrate-to-supabase.mjs --provision-only",
    "migrate:supabase": "node --experimental-strip-types scripts/migrate-to-supabase.mjs",
    "migrate:account-only": "node --experimental-strip-types scripts/migrate-to-account-only.mjs",
    "add:member": "node --experimental-strip-types scripts/add-archive-member.mjs",
    "verify:supabase": "node --experimental-strip-types scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hocuspocus/provider": "4.6.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-router": "^1.168.25",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-collaboration": "3.30.5",
    "@tiptap/extension-collaboration-caret": "3.30.5",
    "@tiptap/extension-drag-handle-react": "3.30.5",
    "@tiptap/extension-find-and-replace": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/extension-typography": "3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=11"
  }
}
