# Public browser configuration. Use the same three names as GitHub Actions variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The collaboration server. `ws://127.0.0.1:8080` against a local one.
VITE_COLLAB_URL=

# The published web app, which is where an invitation link has to point.
# The desktop build needs it; the web build reads its own origin instead.
VITE_WEB_ORIGIN=https://jacopo792.github.io/note-sharing-app/
