# Public browser configuration. Use the same three names as GitHub Actions variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The collaboration server. `ws://127.0.0.1:8080` against a local one.
VITE_COLLAB_URL=

# The published web app, which is where an invitation link has to point.
# The desktop build needs it. The web build uses this when set.
VITE_WEB_ORIGIN=https://nappnote.com/

# Optional public Stripe key for Plus billing. Use pk_test_ in test environments.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional Napp Web import. All three entries are public browser identifiers.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_PROJECT_NUMBER=
# Optional OAuth Desktop app client ID for Electron.
VITE_GOOGLE_DRIVE_DESKTOP_CLIENT_ID=
GOOGLE_DRIVE_DESKTOP_CLIENT_SECRET=

# Optional Auth challenge. Set the same provider in Supabase Auth.
VITE_AUTH_CAPTCHA_PROVIDER=turnstile
VITE_AUTH_CAPTCHA_SITE_KEY=
