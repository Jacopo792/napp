# Browser-safe Supabase configuration. The publishable key is not a secret.
VITE_SUPABASE_URL=https://uftkmoboidcshzoudwzj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_X3etQwXMht2ZVDnztfBDPQ_LLc_cG4m

# Server-side migration only. Never prefix this value with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Two existing Supabase Auth accounts plus their independent archive passphrases.
USER_ONE_EMAIL=
USER_ONE_PASSWORD=
USER_ONE_PASSPHRASE=
USER_TWO_EMAIL=
USER_TWO_PASSWORD=
USER_TWO_PASSPHRASE=

# Legacy GitHub archive, read only by scripts/migrate-to-supabase.mjs.
# Generate MASTER_SEED with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is your root secret. Back it up. Losing it means losing all notes.
MASTER_SEED=

# Fine-grained GitHub PAT — scope: Contents (Read & Write) on this repo only.
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_PAT=

# Target repository in "owner/repo" format
GITHUB_REPO=
